<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="olympic_corridor.net.xml"/>
        <route-files value="olympic_corridor_fixed.rou.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="1"/>
    </time>
    <processing>
        <time-to-teleport value="-1"/>
        <collision.action value="warn"/>
    </processing>
    <report>
        <verbose value="true"/>
        <duration-log.statistics value="true"/>
    </report>
</configuration>
