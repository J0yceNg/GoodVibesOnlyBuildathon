<?xml version="1.0" encoding="UTF-8"?>
<routes>
    <!-- Vehicle Types -->
    <vType id="car" vClass="passenger" color="0.8,0.8,0.8" length="5" maxSpeed="22.22" accel="2.6" decel="4.5" sigma="0.5">
        <param key="priority" value="1"/>
    </vType>
    
    <vType id="regular_bus" vClass="bus" color="0,0.8,0" length="12" width="2.5" maxSpeed="15" accel="1.2" decel="3.0" sigma="0.3">
        <param key="priority" value="2"/>
    </vType>
    
    <vType id="olympic_shuttle" vClass="bus" color="1,0.84,0" length="12" width="2.5" maxSpeed="18" accel="1.5" decel="3.0" sigma="0.2">
        <param key="priority" value="3"/>
        <param key="is_olympic" value="true"/>
    </vType>
    
    <vType id="accessible_vehicle" vClass="bus" color="0,0.5,1" length="10" width="2.4" maxSpeed="15" accel="1.2" decel="3.0" sigma="0.2">
        <param key="priority" value="4"/>
        <param key="is_accessible" value="true"/>
    </vType>
    
    <vType id="emergency" vClass="emergency" color="1,0,0" length="7" maxSpeed="25" accel="2.5" decel="4.5" sigma="0.1">
        <param key="priority" value="5"/>
        <param key="is_emergency" value="true"/>
    </vType>

    <!-- ============================================ -->
    <!-- MAIN OLYMPIC CORRIDOR ROUTES (Row 1 - Middle) -->
    <!-- ============================================ -->
    
    <!-- East-West routes -->
    <route id="olympic_short_ew" edges="A1B1 B1C1"/>
    <route id="olympic_long_ew" edges="A1B1 B1C1 C1D1"/>
    <route id="olympic_full_ew" edges="A1B1 B1C1 C1D1"/>
    
    <!-- West-East routes -->
    <route id="olympic_short_we" edges="C1B1 B1A1"/>
    <route id="olympic_long_we" edges="D1C1 C1B1 B1A1"/>
    <route id="olympic_full_we" edges="D1C1 C1B1 B1A1"/>
    
    <!-- Routes with turns (realistic) -->
    <route id="olympic_turn_north_b" edges="A1B1 B1B2"/>
    <route id="olympic_turn_south_b" edges="A1B1 B1B0"/>
    <route id="olympic_turn_north_c" edges="B1C1 C1C2"/>
    <route id="olympic_turn_south_c" edges="B1C1 C1C0"/>
    
    <!-- ============================================ -->
    <!-- NORTH STREET ROUTES (Row 2) -->
    <!-- ============================================ -->
    <route id="north_ew" edges="A2B2 B2C2 C2D2"/>
    <route id="north_we" edges="D2C2 C2B2 B2A2"/>
    <route id="north_short" edges="A2B2 B2C2"/>
    <route id="north_turn_south" edges="A2B2 B2B1"/>
    
    <!-- ============================================ -->
    <!-- SOUTH STREET ROUTES (Row 0) -->
    <!-- ============================================ -->
    <route id="south_ew" edges="A0B0 B0C0 C0D0"/>
    <route id="south_we" edges="D0C0 C0B0 B0A0"/>
    <route id="south_short" edges="A0B0 B0C0"/>
    <route id="south_turn_north" edges="A0B0 B0B1"/>
    
    <!-- ============================================ -->
    <!-- NORTH-SOUTH CROSS ROUTES -->
    <!-- ============================================ -->
    <route id="cross_a_ns" edges="A0A1 A1A2"/>
    <route id="cross_a_sn" edges="A2A1 A1A0"/>
    <route id="cross_b_ns" edges="B0B1 B1B2"/>
    <route id="cross_b_sn" edges="B2B1 B1B0"/>
    <route id="cross_c_ns" edges="C0C1 C1C2"/>
    <route id="cross_c_sn" edges="C2C1 C1C0"/>
    <route id="cross_d_ns" edges="D0D1 D1D2"/>
    <route id="cross_d_sn" edges="D2D1 D1D0"/>
    
    <!-- ============================================ -->
    <!-- COMPLEX MULTI-TURN ROUTES (Very Realistic) -->
    <!-- ============================================ -->
    <route id="complex_1" edges="A0A1 A1B1 B1C1 C1C0"/>
    <route id="complex_2" edges="A2A1 A1B1 B1B0"/>
    <route id="complex_3" edges="D0D1 D1C1 C1B1 B1A1"/>
    <route id="complex_4" edges="A0B0 B0B1 B1C1 C1D1"/>


    <!-- ============================================ -->
    <!-- TRAFFIC FLOWS - OLYMPIC CORRIDOR (Priority) -->
    <!-- ============================================ -->
    
    <!-- PERIOD 1: Early Morning (0-900s) -->
    <flow id="early_olympic_ew_1" type="car" begin="0" end="900" route="olympic_long_ew" probability="0.08" departLane="best"/>
    <flow id="early_olympic_we_1" type="car" begin="0" end="900" route="olympic_long_we" probability="0.07" departLane="best"/>
    <flow id="early_olympic_turns" type="car" begin="0" end="900" route="olympic_turn_north_b" probability="0.03" departLane="best"/>
    <flow id="early_buses" type="regular_bus" begin="0" end="900" route="olympic_full_ew" period="180" departLane="0"/>
    
    <!-- PERIOD 2: Morning Rush (900-1800s) -->
    <flow id="rush_olympic_ew" type="car" begin="900" end="1800" route="olympic_long_ew" probability="0.45" departLane="best"/>
    <flow id="rush_olympic_we" type="car" begin="900" end="1800" route="olympic_long_we" probability="0.42" departLane="best"/>
    <flow id="rush_olympic_short" type="car" begin="900" end="1800" route="olympic_short_ew" probability="0.15" departLane="best"/>
    <flow id="rush_olympic_turns" type="car" begin="900" end="1800" route="olympic_turn_south_c" probability="0.10" departLane="best"/>
    <flow id="rush_buses" type="regular_bus" begin="900" end="1800" route="olympic_full_ew" period="60" departLane="0"/>
    <flow id="rush_accessible" type="accessible_vehicle" begin="900" end="1800" route="olympic_full_ew" period="300" departLane="0"/>
    
    <!-- PERIOD 3: Olympic Event (1800-2700s) - HIGH PRIORITY -->
    <flow id="event_olympic_ew" type="car" begin="1800" end="2700" route="olympic_long_ew" probability="0.25" departLane="best"/>
    <flow id="event_olympic_we" type="car" begin="1800" end="2700" route="olympic_long_we" probability="0.22" departLane="best"/>
    <flow id="event_buses" type="regular_bus" begin="1800" end="2700" route="olympic_full_ew" period="90" departLane="0"/>
    
    <!-- OLYMPIC SHUTTLES - Very high frequency -->
    <flow id="event_shuttle_ew" type="olympic_shuttle" begin="1800" end="2700" route="olympic_full_ew" period="25" departLane="0"/>
    <flow id="event_shuttle_we" type="olympic_shuttle" begin="1800" end="2700" route="olympic_full_we" period="30" departLane="0"/>

    <!-- ACCESSIBLE VEHICLES - More frequent -->
    <flow id="event_accessible_ew" type="accessible_vehicle" begin="1800" end="2700" route="olympic_full_ew" period="45" departLane="0"/>
    <flow id="event_accessible_we" type="accessible_vehicle" begin="1800" end="2700" route="olympic_full_we" period="50" departLane="0"/>

    <!-- PERIOD 4: Evening (2700-3600s) -->
    <flow id="evening_olympic_ew" type="car" begin="2700" end="3600" route="olympic_long_ew" probability="0.18" departLane="best"/>
    <flow id="evening_olympic_we" type="car" begin="2700" end="3600" route="olympic_long_we" probability="0.16" departLane="best"/>
    <flow id="evening_buses" type="regular_bus" begin="2700" end="3600" route="olympic_full_ew" period="120" departLane="0"/>
    <flow id="evening_shuttles" type="olympic_shuttle" begin="2700" end="3600" route="olympic_full_ew" period="180" departLane="0"/>
    
    <!-- EMERGENCY VEHICLES (all day) -->
    <flow id="emergency_olympic" type="emergency" begin="100" end="3600" route="olympic_full_ew" period="500" departLane="free" departSpeed="max"/>
    <flow id="emergency_complex" type="emergency" begin="250" end="3600" route="complex_3" period="600" departLane="free" departSpeed="max"/>
    

    <!-- ============================================ -->
    <!-- PARALLEL STREETS TRAFFIC (Background) -->
    <!-- ============================================ -->
    
    <!-- North Street (Row 2) -->
    <flow id="north_cars_ew" type="car" begin="0" end="3600" route="north_ew" probability="0.15" departLane="best"/>
    <flow id="north_cars_we" type="car" begin="0" end="3600" route="north_we" probability="0.14" departLane="best"/>
    <flow id="north_turns" type="car" begin="0" end="3600" route="north_turn_south" probability="0.05" departLane="best"/>
    
    <!-- South Street (Row 0) -->
    <flow id="south_cars_ew" type="car" begin="0" end="3600" route="south_ew" probability="0.16" departLane="best"/>
    <flow id="south_cars_we" type="car" begin="0" end="3600" route="south_we" probability="0.15" departLane="best"/>
    <flow id="south_turns" type="car" begin="0" end="3600" route="south_turn_north" probability="0.06" departLane="best"/>
    <flow id="south_buses" type="regular_bus" begin="0" end="3600" route="south_ew" period="200" departLane="0"/>
    

    <!-- ============================================ -->
    <!-- CROSS TRAFFIC (North-South) -->
    <!-- ============================================ -->
    
    <flow id="cross_a_ns_flow" type="car" begin="0" end="3600" route="cross_a_ns" probability="0.12" departLane="best"/>
    <flow id="cross_a_sn_flow" type="car" begin="0" end="3600" route="cross_a_sn" probability="0.11" departLane="best"/>
    
    <flow id="cross_b_ns_flow" type="car" begin="0" end="3600" route="cross_b_ns" probability="0.14" departLane="best"/>
    <flow id="cross_b_sn_flow" type="car" begin="0" end="3600" route="cross_b_sn" probability="0.13" departLane="best"/>
    
    <flow id="cross_c_ns_flow" type="car" begin="0" end="3600" route="cross_c_ns" probability="0.13" departLane="best"/>
    <flow id="cross_c_sn_flow" type="car" begin="0" end="3600" route="cross_c_sn" probability="0.12" departLane="best"/>
    
    <flow id="cross_d_ns_flow" type="car" begin="0" end="3600" route="cross_d_ns" probability="0.10" departLane="best"/>
    <flow id="cross_d_sn_flow" type="car" begin="0" end="3600" route="cross_d_sn" probability="0.09" departLane="best"/>
    

    <!-- ============================================ -->
    <!-- COMPLEX ROUTES (Realistic City Driving) -->
    <!-- ============================================ -->
    
    <flow id="complex_route_1" type="car" begin="0" end="3600" route="complex_1" probability="0.08" departLane="best"/>
    <flow id="complex_route_2" type="car" begin="0" end="3600" route="complex_2" probability="0.07" departLane="best"/>
    <flow id="complex_route_3" type="car" begin="0" end="3600" route="complex_3" probability="0.06" departLane="best"/>
    <flow id="complex_route_4" type="car" begin="0" end="3600" route="complex_4" probability="0.09" departLane="best"/>

</routes>
